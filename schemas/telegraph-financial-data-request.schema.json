{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FinancialDataRequest",
  "type": "object",
  "properties": {
    "asset": {
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/DataSourcePreference",
      "default": "AUTO"
    },
    "timeframe": {
      "$ref": "#/$defs/RegisteredFinancialTimeframe",
      "default": "D1"
    }
  },
  "additionalProperties": false,
  "required": [
    "asset"
  ],
  "$defs": {
    "DataSourcePreference": {
      "type": "string",
      "enum": [
        "AUTO",
        "SUPPLIED_CORPUS"
      ]
    },
    "RegisteredFinancialTimeframe": {
      "type": "string",
      "enum": [
        "D1",
        "W1"
      ]
    }
  }
}
