{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FinancialSignalResponse",
  "type": "object",
  "properties": {
    "as_of_ns": {
      "type": "integer",
      "format": "int64"
    },
    "data_watermark_ns": {
      "type": "integer",
      "format": "int64"
    },
    "direction": {
      "$ref": "#/$defs/Direction"
    },
    "instrument": {
      "$ref": "#/$defs/Instrument"
    },
    "mode": {
      "$ref": "#/$defs/SignalMode"
    },
    "probabilities_bp": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProbabilitiesBp"
        },
        {
          "type": "null"
        }
      ]
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "scales": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PerScaleSignal"
      }
    },
    "schema": {
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RuntimeStatus"
    }
  },
  "required": [
    "schema",
    "status",
    "instrument",
    "as_of_ns",
    "data_watermark_ns",
    "mode",
    "direction",
    "scales",
    "provenance"
  ],
  "$defs": {
    "AssetClass": {
      "type": "string",
      "enum": [
        "crypto",
        "stock",
        "index",
        "forex",
        "futures",
        "commodity"
      ]
    },
    "AvailabilityStatus": {
      "type": "string",
      "enum": [
        "AVAILABLE",
        "UNAVAILABLE",
        "NOT_APPLICABLE",
        "STALE"
      ]
    },
    "CalibrationScope": {
      "type": "string",
      "enum": [
        "INSTRUMENT",
        "ASSET_CLASS",
        "GLOBAL",
        "UNAVAILABLE"
      ]
    },
    "ComponentSnapshot": {
      "type": "object",
      "properties": {
        "availability": {
          "$ref": "#/$defs/AvailabilityStatus"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": true
      },
      "required": [
        "availability"
      ]
    },
    "Direction": {
      "type": "string",
      "enum": [
        "UP",
        "DOWN",
        "RANGE",
        "UNRESOLVED"
      ]
    },
    "Horizon": {
      "type": "object",
      "properties": {
        "median_bars": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "median_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "p25_bars": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "p25_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "p75_bars": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "p75_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      }
    },
    "Instrument": {
      "type": "object",
      "properties": {
        "asset_class": {
          "$ref": "#/$defs/AssetClass"
        },
        "base": {
          "type": [
            "string",
            "null"
          ]
        },
        "historical_data_capable": {
          "type": "boolean"
        },
        "instrument_id": {
          "type": "string"
        },
        "live_data_capable": {
          "type": "boolean"
        },
        "price_precision": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "quantity_precision": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "quote": {
          "type": [
            "string",
            "null"
          ]
        },
        "session_calendar": {
          "$ref": "#/$defs/SessionCalendar"
        },
        "symbol": {
          "type": "string"
        },
        "timezone": {
          "type": "string"
        },
        "venue": {
          "type": "string"
        }
      },
      "required": [
        "instrument_id",
        "asset_class",
        "symbol",
        "venue",
        "timezone",
        "session_calendar",
        "live_data_capable",
        "historical_data_capable"
      ]
    },
    "PerScaleSignal": {
      "type": "object",
      "properties": {
        "calibration_scope": {
          "$ref": "#/$defs/CalibrationScope"
        },
        "direction": {
          "$ref": "#/$defs/Direction"
        },
        "horizon": {
          "anyOf": [
            {
              "$ref": "#/$defs/Horizon"
            },
            {
              "type": "null"
            }
          ]
        },
        "probabilities_bp": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProbabilitiesBp"
            },
            {
              "type": "null"
            }
          ]
        },
        "reliability_bp": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "sample_support": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "structural": {
          "$ref": "#/$defs/StructuralSnapshot"
        },
        "timeframe": {
          "$ref": "#/$defs/Timeframe"
        }
      },
      "required": [
        "timeframe",
        "structural",
        "direction",
        "sample_support",
        "calibration_scope"
      ]
    },
    "ProbabilitiesBp": {
      "type": "object",
      "properties": {
        "down": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "range": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "up": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "required": [
        "up",
        "range",
        "down"
      ]
    },
    "Provenance": {
      "type": "object",
      "properties": {
        "engine_config_sha256": {
          "type": "string"
        },
        "engine_version": {
          "type": "string"
        },
        "input_window_sha256": {
          "type": "string"
        },
        "primary_provider": {
          "type": "string"
        },
        "resolution_calibration_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "resolution_profile_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "response_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "runtime_config_sha256": {
          "type": "string"
        },
        "secondary_provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_watermark": {
          "type": "string"
        },
        "structural_vector_version": {
          "type": "string"
        }
      },
      "required": [
        "primary_provider",
        "source_watermark",
        "input_window_sha256",
        "engine_version",
        "engine_config_sha256",
        "structural_vector_version",
        "runtime_config_sha256"
      ]
    },
    "RuntimeStatus": {
      "type": "string",
      "enum": [
        "OK",
        "BOOTSTRAPPING",
        "UNRESOLVED",
        "INSUFFICIENT_DATA",
        "INSUFFICIENT_CALIBRATION",
        "STALE_DATA",
        "PROVIDER_DIVERGENCE",
        "AMBIGUOUS_ASSET",
        "UNSUPPORTED_ASSET",
        "ENGINE_ERROR"
      ]
    },
    "SessionCalendar": {
      "type": "string",
      "enum": [
        "CONTINUOUS_UTC",
        "EXCHANGE_SESSION"
      ]
    },
    "SignalMode": {
      "type": "string",
      "enum": [
        "CONFIRMED",
        "LIVE_PREVIEW"
      ]
    },
    "StructuralSnapshot": {
      "type": "object",
      "properties": {
        "as_of_ns": {
          "type": "integer",
          "format": "int64"
        },
        "availability": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/AvailabilityStatus"
          }
        },
        "d_o": {
          "$ref": "#/$defs/ComponentSnapshot"
        },
        "engine_version": {
          "type": "string"
        },
        "instrument_id": {
          "type": "string"
        },
        "k_mem": {
          "$ref": "#/$defs/ComponentSnapshot"
        },
        "odce": {
          "$ref": "#/$defs/ComponentSnapshot"
        },
        "prama": {
          "$ref": "#/$defs/ComponentSnapshot"
        },
        "snapshot_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_watermark": {
          "type": "string"
        },
        "structural_state": {
          "type": "string"
        },
        "timeframe": {
          "$ref": "#/$defs/Timeframe"
        }
      },
      "required": [
        "instrument_id",
        "timeframe",
        "as_of_ns",
        "engine_version",
        "structural_state",
        "prama",
        "d_o",
        "odce",
        "k_mem",
        "availability",
        "source_watermark"
      ]
    },
    "Timeframe": {
      "type": "string",
      "enum": [
        "M1",
        "M5",
        "H1",
        "H4",
        "D1",
        "W1"
      ]
    }
  }
}
