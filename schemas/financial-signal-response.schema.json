{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FinancialSignalResponse",
  "type": "object",
  "properties": {
    "as_of_ns": {
      "type": "integer",
      "format": "int64"
    },
    "data_watermark_ns": {
      "type": "integer",
      "format": "int64"
    },
    "direction": {
      "$ref": "#/$defs/Direction"
    },
    "instrument": {
      "$ref": "#/$defs/Instrument"
    },
    "label": {
      "type": "string"
    },
    "mode": {
      "$ref": "#/$defs/SignalMode"
    },
    "probabilities_bp": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProbabilitiesBp"
        },
        {
          "type": "null"
        }
      ]
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "scales": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PerScaleSignal"
      }
    },
    "schema": {
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RuntimeStatus"
    }
  },
  "required": [
    "schema",
    "status",
    "instrument",
    "as_of_ns",
    "data_watermark_ns",
    "mode",
    "direction",
    "label",
    "scales",
    "provenance"
  ],
  "$defs": {
    "AssetClass": {
      "type": "string",
      "enum": [
        "crypto",
        "stock",
        "index",
        "forex",
        "futures",
        "commodity"
      ]
    },
    "AvailabilityStatus": {
      "type": "string",
      "enum": [
        "AVAILABLE",
        "UNAVAILABLE",
        "NOT_APPLICABLE",
        "STALE"
      ]
    },
    "AvailableValue": {
      "type": "object",
      "properties": {
        "availability": {
          "$ref": "#/$defs/AvailabilityStatus"
        },
        "value": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "availability"
      ]
    },
    "CalibrationScope": {
      "type": "string",
      "enum": [
        "INSTRUMENT",
        "ASSET_CLASS",
        "GLOBAL",
        "UNAVAILABLE"
      ]
    },
    "ComponentSnapshot": {
      "type": "object",
      "properties": {
        "availability": {
          "$ref": "#/$defs/AvailabilityStatus"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": true
      },
      "required": [
        "availability"
      ]
    },
    "ContrastEvidenceItem": {
      "type": "object",
      "properties": {
        "reasoning": {
          "type": "string"
        },
        "structural_field": {
          "type": "string"
        },
        "structural_value": {
          "type": "string"
        },
        "technical_direction": {
          "$ref": "#/$defs/TechnicalDirection"
        }
      },
      "required": [
        "structural_field",
        "structural_value",
        "technical_direction",
        "reasoning"
      ]
    },
    "ContrastState": {
      "type": "string",
      "enum": [
        "CONFIRMING",
        "CONFLICTING",
        "MIXED",
        "NEUTRAL",
        "UNAVAILABLE"
      ]
    },
    "CounterReading": {
      "type": "string",
      "enum": [
        "NONE",
        "UP",
        "DOWN"
      ]
    },
    "CounterReadingEvidence": {
      "type": "object",
      "properties": {
        "bollinger_position": {
          "anyOf": [
            {
              "$ref": "#/$defs/CounterReading"
            },
            {
              "type": "null"
            }
          ]
        },
        "ema_extension": {
          "$ref": "#/$defs/AvailableValue"
        },
        "rsi_extreme": {
          "anyOf": [
            {
              "$ref": "#/$defs/CounterReading"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "ema_extension"
      ]
    },
    "Direction": {
      "type": "string",
      "enum": [
        "UP",
        "DOWN",
        "RANGE",
        "UNRESOLVED"
      ]
    },
    "DirectionalResolution": {
      "type": "object",
      "properties": {
        "calibration_scope": {
          "$ref": "#/$defs/CalibrationScope"
        },
        "direction": {
          "$ref": "#/$defs/Direction"
        },
        "horizon": {
          "anyOf": [
            {
              "$ref": "#/$defs/Horizon"
            },
            {
              "type": "null"
            }
          ]
        },
        "probabilities_bp": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProbabilitiesBp"
            },
            {
              "type": "null"
            }
          ]
        },
        "profile_sha256": {
          "type": "string"
        },
        "publication_reason": {
          "type": "string"
        },
        "reliability_bp": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "sample_support": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "direction",
        "sample_support",
        "calibration_scope",
        "profile_sha256",
        "publication_reason"
      ]
    },
    "Horizon": {
      "type": "object",
      "properties": {
        "median_bars": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "median_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "p25_bars": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "p25_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "p75_bars": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "p75_seconds": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      }
    },
    "IndicatorValues": {
      "type": "object",
      "properties": {
        "adx14": {
          "$ref": "#/$defs/AvailableValue"
        },
        "atr14": {
          "$ref": "#/$defs/AvailableValue"
        },
        "bollinger_lower": {
          "$ref": "#/$defs/AvailableValue"
        },
        "bollinger_middle": {
          "$ref": "#/$defs/AvailableValue"
        },
        "bollinger_upper": {
          "$ref": "#/$defs/AvailableValue"
        },
        "ema20": {
          "$ref": "#/$defs/AvailableValue"
        },
        "ema20_slope": {
          "$ref": "#/$defs/AvailableValue"
        },
        "ema50": {
          "$ref": "#/$defs/AvailableValue"
        },
        "macd_histogram": {
          "$ref": "#/$defs/AvailableValue"
        },
        "rsi14": {
          "$ref": "#/$defs/AvailableValue"
        }
      },
      "required": [
        "ema20",
        "ema50",
        "ema20_slope",
        "macd_histogram",
        "rsi14",
        "adx14",
        "atr14",
        "bollinger_upper",
        "bollinger_lower",
        "bollinger_middle"
      ]
    },
    "Instrument": {
      "type": "object",
      "properties": {
        "asset_class": {
          "$ref": "#/$defs/AssetClass"
        },
        "base": {
          "type": [
            "string",
            "null"
          ]
        },
        "historical_data_capable": {
          "type": "boolean"
        },
        "instrument_id": {
          "type": "string"
        },
        "live_data_capable": {
          "type": "boolean"
        },
        "price_precision": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "quantity_precision": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "quote": {
          "type": [
            "string",
            "null"
          ]
        },
        "session_calendar": {
          "$ref": "#/$defs/SessionCalendar"
        },
        "symbol": {
          "type": "string"
        },
        "timezone": {
          "type": "string"
        },
        "venue": {
          "type": "string"
        }
      },
      "required": [
        "instrument_id",
        "asset_class",
        "symbol",
        "venue",
        "timezone",
        "session_calendar",
        "live_data_capable",
        "historical_data_capable"
      ]
    },
    "PerScaleSignal": {
      "type": "object",
      "properties": {
        "calibration_scope": {
          "$ref": "#/$defs/CalibrationScope"
        },
        "counter_reading": {
          "anyOf": [
            {
              "$ref": "#/$defs/TechnicalCounterReading"
            },
            {
              "type": "null"
            }
          ]
        },
        "direction": {
          "$ref": "#/$defs/Direction"
        },
        "directional": {
          "anyOf": [
            {
              "$ref": "#/$defs/DirectionalResolution"
            },
            {
              "type": "null"
            }
          ]
        },
        "horizon": {
          "anyOf": [
            {
              "$ref": "#/$defs/Horizon"
            },
            {
              "type": "null"
            }
          ]
        },
        "probabilities_bp": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProbabilitiesBp"
            },
            {
              "type": "null"
            }
          ]
        },
        "reliability_bp": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "sample_support": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "structural": {
          "$ref": "#/$defs/StructuralSnapshot"
        },
        "structural_contrast": {
          "anyOf": [
            {
              "$ref": "#/$defs/TechnicalStructuralContrast"
            },
            {
              "type": "null"
            }
          ]
        },
        "technical": {
          "anyOf": [
            {
              "$ref": "#/$defs/TechnicalDirectionHead"
            },
            {
              "type": "null"
            }
          ]
        },
        "timeframe": {
          "$ref": "#/$defs/Timeframe"
        }
      },
      "required": [
        "timeframe",
        "structural",
        "direction",
        "sample_support",
        "calibration_scope"
      ]
    },
    "ProbabilitiesBp": {
      "type": "object",
      "properties": {
        "down": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "range": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "up": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "required": [
        "up",
        "range",
        "down"
      ]
    },
    "Provenance": {
      "type": "object",
      "properties": {
        "engine_config_sha256": {
          "type": "string"
        },
        "engine_version": {
          "type": "string"
        },
        "input_window_sha256": {
          "type": "string"
        },
        "primary_provider": {
          "type": "string"
        },
        "request_sha256": {
          "description": "Canonical SHA-256 of the native request that produced this response.\nThis field belongs to the native API contract; the registered Telegraph\nresponse uses `service::ServiceProvenance` and is intentionally unchanged.",
          "type": "string"
        },
        "resolution_calibration_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "resolution_profile_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "response_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "runtime_config_sha256": {
          "type": "string"
        },
        "secondary_provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_watermark": {
          "type": "string"
        },
        "structural_vector_version": {
          "type": "string"
        }
      },
      "required": [
        "primary_provider",
        "source_watermark",
        "input_window_sha256",
        "engine_version",
        "engine_config_sha256",
        "structural_vector_version",
        "runtime_config_sha256",
        "request_sha256"
      ]
    },
    "RangeDetection": {
      "type": "object",
      "properties": {
        "adx14": {
          "$ref": "#/$defs/AvailableValue"
        },
        "ema_separation_atr": {
          "$ref": "#/$defs/AvailableValue"
        },
        "is_range": {
          "type": "boolean"
        }
      },
      "required": [
        "adx14",
        "ema_separation_atr",
        "is_range"
      ]
    },
    "RuntimeStatus": {
      "type": "string",
      "enum": [
        "OK",
        "BOOTSTRAPPING",
        "UNRESOLVED",
        "INSUFFICIENT_DATA",
        "INSUFFICIENT_CALIBRATION",
        "STALE_DATA",
        "PROVIDER_DIVERGENCE",
        "AMBIGUOUS_ASSET",
        "UNSUPPORTED_ASSET",
        "ENGINE_ERROR"
      ]
    },
    "SessionCalendar": {
      "type": "string",
      "enum": [
        "CONTINUOUS_UTC",
        "EXCHANGE_SESSION"
      ]
    },
    "SignalMode": {
      "type": "string",
      "enum": [
        "CONFIRMED",
        "LIVE_PREVIEW"
      ]
    },
    "StructuralContrast": {
      "type": "object",
      "properties": {
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContrastEvidenceItem"
          }
        },
        "state": {
          "$ref": "#/$defs/ContrastState"
        }
      },
      "required": [
        "state",
        "evidence"
      ]
    },
    "StructuralSnapshot": {
      "type": "object",
      "properties": {
        "as_of_ns": {
          "type": "integer",
          "format": "int64"
        },
        "availability": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/AvailabilityStatus"
          }
        },
        "d_o": {
          "$ref": "#/$defs/ComponentSnapshot"
        },
        "engine_version": {
          "type": "string"
        },
        "instrument_id": {
          "type": "string"
        },
        "k_mem": {
          "$ref": "#/$defs/ComponentSnapshot"
        },
        "odce": {
          "$ref": "#/$defs/ComponentSnapshot"
        },
        "prama": {
          "$ref": "#/$defs/ComponentSnapshot"
        },
        "snapshot_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_watermark": {
          "type": "string"
        },
        "structural_state": {
          "type": "string"
        },
        "timeframe": {
          "$ref": "#/$defs/Timeframe"
        }
      },
      "required": [
        "instrument_id",
        "timeframe",
        "as_of_ns",
        "engine_version",
        "structural_state",
        "prama",
        "d_o",
        "odce",
        "k_mem",
        "availability",
        "source_watermark"
      ]
    },
    "TechnicalCounterReading": {
      "type": "object",
      "properties": {
        "direction": {
          "$ref": "#/$defs/CounterReading"
        },
        "evidence": {
          "$ref": "#/$defs/CounterReadingEvidence"
        }
      },
      "required": [
        "direction",
        "evidence"
      ]
    },
    "TechnicalDirection": {
      "type": "string",
      "enum": [
        "UP",
        "DOWN",
        "RANGE",
        "UNAVAILABLE"
      ]
    },
    "TechnicalDirectionHead": {
      "type": "object",
      "properties": {
        "bars_used": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "direction": {
          "$ref": "#/$defs/TechnicalDirection"
        },
        "indicators": {
          "$ref": "#/$defs/IndicatorValues"
        },
        "range_detection": {
          "$ref": "#/$defs/RangeDetection"
        },
        "votes": {
          "$ref": "#/$defs/VoteBreakdown"
        }
      },
      "required": [
        "direction",
        "votes",
        "range_detection",
        "indicators",
        "bars_used"
      ]
    },
    "TechnicalStructuralContrast": {
      "type": "object",
      "properties": {
        "counter_reading": {
          "$ref": "#/$defs/TechnicalCounterReading"
        },
        "structural": {
          "$ref": "#/$defs/StructuralSnapshot"
        },
        "structural_contrast": {
          "$ref": "#/$defs/StructuralContrast"
        },
        "technical": {
          "$ref": "#/$defs/TechnicalDirectionHead"
        },
        "timeframe": {
          "$ref": "#/$defs/Timeframe"
        }
      },
      "required": [
        "timeframe",
        "structural",
        "technical",
        "counter_reading",
        "structural_contrast"
      ]
    },
    "Timeframe": {
      "type": "string",
      "enum": [
        "M1",
        "M5",
        "H1",
        "H4",
        "D1",
        "W1"
      ]
    },
    "VoteBreakdown": {
      "type": "object",
      "properties": {
        "ema_slope": {
          "$ref": "#/$defs/TechnicalDirection"
        },
        "ema_trend": {
          "$ref": "#/$defs/TechnicalDirection"
        },
        "macd": {
          "$ref": "#/$defs/TechnicalDirection"
        },
        "rsi_centerline": {
          "$ref": "#/$defs/TechnicalDirection"
        }
      },
      "required": [
        "ema_trend",
        "ema_slope",
        "macd",
        "rsi_centerline"
      ]
    }
  }
}
